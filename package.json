{
  "name": "cruncheevos-playtest",
  "version": "0.1.0",
  "description": "Playtest RetroAchievements achievements: record emulator memory as Test Scenarios, replay them against cruncheevos achievement logic in tests, and inspect every frame in a viewer",
  "keywords": [
    "retroachievements",
    "cruncheevos",
    "rcheevos",
    "achievements",
    "testing",
    "emulator"
  ],
  "type": "module",
  "bin": {
    "cruncheevos-playtest": "bin/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./testing": "./src/testing.js"
  },
  "files": [
    "bin",
    "src",
    "lua",
    "viewer",
    "scaffold",
    "README.md",
    "LICENSE",
    "how-achievements-work.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "viewer": "node bin/cli.js viewer"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akleemans/cruncheevos-playtest.git"
  },
  "homepage": "https://github.com/akleemans/cruncheevos-playtest#readme",
  "bugs": {
    "url": "https://github.com/akleemans/cruncheevos-playtest/issues"
  },
  "author": "Adrianus Kleemans"
}
