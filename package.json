{
  "name": "cruncheevos-playtest",
  "version": "0.1.0",
  "description": "Playtest RetroAchievements achievements: record emulator memory as Test Scenarios, replay them against cruncheevos achievement logic in tests, and inspect every frame in a viewer",
  "keywords": [
    "retroachievements",
    "cruncheevos",
    "rcheevos",
    "achievements",
    "testing",
    "emulator"
  ],
  "type": "module",
  "bin": {
    "cruncheevos-playtest": "bin/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./testing": "./src/testing.js",
    "./vitest": "./src/vitest.js"
  },
  "files": [
    "bin",
    "src",
    "lua",
    "viewer",
    "scaffold",
    "docs",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "viewer": "node bin/cli.js viewer"
  },
  "license": "MIT",
  "devDependencies": {
    "vitest": "^4.1.9"
  }
}
